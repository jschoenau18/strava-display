[Unit]
Description=Strava E-Paper Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jschoenau
WorkingDirectory=/home/jschoenau/strava-api-display
ExecStart=/usr/bin/flock -w 60 /home/jschoenau/strava-api-display/.dashboard.lock /home/jschoenau/strava-api-display/.venv/bin/python main.py
